{
  "name": "drop-in-marketplace-os",
  "version": "0.9.2",
  "private": true,
  "description": "Framework modular para geração e análise de anúncios de marketplaces.",
  "type": "module",
  "scripts": {
    "test": "npm run validate:contracts && node --test tests/*.test.mjs",
    "validate:contracts": "node tools/validate-contracts.mjs",
    "cli": "node src/interfaces/cli.mjs",
    "check:release": "node tools/check-release.mjs",
    "check:architecture": "node tools/validate-architecture.mjs",
    "check:contracts": "node tools/check-contract-compatibility.mjs",
    "check": "npm test && npm run check:architecture && npm run check:contracts && npm run check:release && npm audit --audit-level=high"
  },
  "bin": {
    "drop-in-marketplace-os": "src/interfaces/cli.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "3.0.1"
  }
}