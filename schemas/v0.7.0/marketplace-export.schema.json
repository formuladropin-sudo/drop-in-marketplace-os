{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://drop-in-marketplace-os.dev/schemas/v0.7.0/marketplace-export.schema.json",
  "title": "Marketplace Export",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_type", "channel", "country", "policy_profile_version", "source", "listing", "status", "warnings"],
  "properties": {
    "schema_version": { "const": "0.7.0" },
    "contract_type": { "const": "marketplace_export" },
    "channel": { "type": "string", "minLength": 1 },
    "country": { "type": "string", "pattern": "^[A-Z]{2}$" },
    "policy_profile_version": { "type": "string", "minLength": 1 },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["project_id", "analysis_id"],
      "properties": { "project_id": { "type": "string" }, "analysis_id": { "type": "string" } }
    },
    "listing": {
      "type": "object", "additionalProperties": false,
      "required": ["title", "description", "category_id", "price", "attributes", "variants", "images"],
      "properties": {
        "title": { "type": "string", "minLength": 1 }, "description": { "type": "string", "minLength": 1 },
        "category_id": { "anyOf": [{ "type": "string" }, { "type": "null" }] }, "price": { "type": "object" }, "attributes": { "type": "object" },
        "variants": { "type": "array", "minItems": 1 }, "images": { "type": "array", "minItems": 1 }
      }
    },
    "status": { "enum": ["ready", "needs_review"] },
    "warnings": { "type": "array", "items": { "type": "string" } }
  }
}