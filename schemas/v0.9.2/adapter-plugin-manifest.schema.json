{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://drop-in-marketplace-os.dev/schemas/v0.9.2/adapter-plugin-manifest.schema.json",
  "title": "Adapter Plugin Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_type", "plugins"],
  "properties": {
    "schema_version": { "const": "0.9.2" },
    "contract_type": { "const": "adapter_plugin_manifest" },
    "plugins": {
      "type": "array", "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "module", "export", "enabled"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "module": { "type": "string", "pattern": "^\\./(?!.*\\.\\.)[a-zA-Z0-9_./-]+\\.mjs$" },
          "export": { "type": "string", "pattern": "^[a-zA-Z_$][a-zA-Z0-9_$]*$" },
          "enabled": { "type": "boolean" }
        }
      }
    }
  }
}