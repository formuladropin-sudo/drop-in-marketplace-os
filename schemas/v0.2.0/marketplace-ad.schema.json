{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://drop-in-marketplace-os.dev/schemas/v0.2.0/marketplace-ad.schema.json",
  "title": "DROP-IN Canonical Marketplace Ad Contract",
  "description": "Contrato canônico para fatos, evidências, oferta e contexto de execução de um anúncio.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_type",
    "project_id",
    "marketplace",
    "product",
    "offer",
    "evidence",
    "claims",
    "metadata"
  ],
  "properties": {
    "schema_version": { "const": "0.2.0" },
    "contract_type": { "const": "marketplace_ad" },
    "project_id": { "$ref": "#/$defs/identifier" },
    "marketplace": { "$ref": "#/$defs/marketplace" },
    "product": { "$ref": "#/$defs/product" },
    "offer": { "$ref": "#/$defs/offer" },
    "evidence": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidence" },
      "minItems": 1
    },
    "claims": {
      "type": "array",
      "items": { "$ref": "#/$defs/claim" },
      "minItems": 1
    },
    "assets": {
      "type": "array",
      "items": { "$ref": "#/$defs/assetReference" },
      "default": []
    },
    "metadata": { "$ref": "#/$defs/metadata" }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "marketplace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channel", "country", "locale", "currency"],
      "properties": {
        "channel": { "enum": ["shopee", "mercado_livre", "tiktok_shop", "generic"] },
        "country": { "type": "string", "pattern": "^[A-Z]{2}$" },
        "locale": { "type": "string", "pattern": "^[a-z]{2}-[A-Z]{2}$" },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "category_id": { "type": "string", "minLength": 1 },
        "policy_profile_version": { "type": "string", "minLength": 1 }
      }
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "category", "attributes", "variants"],
      "properties": {
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "brand": { "type": "string", "maxLength": 256 },
        "category": { "$ref": "#/$defs/nonEmptyString" },
        "description_source": { "type": "string", "maxLength": 8192 },
        "attributes": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "oneOf": [
              { "type": "string" },
              { "type": "number" },
              { "type": "boolean" },
              { "type": "array", "items": { "type": "string" } }
            ]
          }
        },
        "variants": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/variant" }
        }
      }
    },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sku", "attributes", "availability"],
      "properties": {
        "sku": { "$ref": "#/$defs/identifier" },
        "gtin": { "type": "string", "pattern": "^[0-9]{8,14}$" },
        "attributes": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "oneOf": [
              { "type": "string" },
              { "type": "number" },
              { "type": "boolean" }
            ]
          }
        },
        "availability": { "enum": ["in_stock", "out_of_stock", "preorder", "unknown"] },
        "stock_quantity": { "type": "integer", "minimum": 0 }
      }
    },
    "offer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["price", "shipping", "warranty"],
      "properties": {
        "price": { "$ref": "#/$defs/money" },
        "compare_at_price": { "$ref": "#/$defs/money" },
        "shipping": {
          "type": "object",
          "additionalProperties": false,
          "required": ["dispatch_time_hours", "scope"],
          "properties": {
            "dispatch_time_hours": { "type": "integer", "minimum": 0, "maximum": 8760 },
            "scope": { "enum": ["seller_dispatch", "estimated_delivery"] },
            "notes": { "type": "string", "maxLength": 1024 }
          }
        },
        "warranty": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {
            "type": { "enum": ["none", "legal", "seller", "manufacturer", "unknown"] },
            "duration_days": { "type": "integer", "minimum": 0 },
            "terms_source": { "type": "string", "maxLength": 2048 }
          }
        }
      }
    },
    "money": {
      "type": "object",
      "additionalProperties": false,
      "required": ["amount", "currency"],
      "properties": {
        "amount": { "type": "number", "minimum": 0, "multipleOf": 0.01 },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "subject", "value", "confidence"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "type": { "enum": ["provided", "observed", "verified", "inferred"] },
        "subject": { "$ref": "#/$defs/nonEmptyString" },
        "value": {},
        "source": { "type": "string", "maxLength": 2048 },
        "captured_at": { "type": "string", "format": "date-time" },
        "confidence": { "type": "integer", "minimum": 0, "maximum": 100 }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "status", "evidence_ids"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "text": { "$ref": "#/$defs/nonEmptyString" },
        "status": { "enum": ["supported", "hypothesis", "prohibited"] },
        "evidence_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/identifier" },
          "uniqueItems": true
        },
        "notes": { "type": "string", "maxLength": 2048 }
      }
    },
    "assetReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "uri", "usage_rights"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "type": { "enum": ["product_image", "detail_image", "brand_asset", "document", "other"] },
        "uri": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "usage_rights": { "enum": ["owned", "licensed", "provided", "unknown"] },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "variant_skus": {
          "type": "array",
          "items": { "$ref": "#/$defs/identifier" },
          "uniqueItems": true
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "created_at", "created_by", "system_version"],
      "properties": {
        "run_id": { "$ref": "#/$defs/identifier" },
        "created_at": { "type": "string", "format": "date-time" },
        "created_by": { "type": "string", "minLength": 1, "maxLength": 256 },
        "system_version": { "const": "0.2.0" },
        "source_revision": { "type": "string", "maxLength": 128 },
        "correlation_id": { "$ref": "#/$defs/identifier" }
      }
    }
  }
}